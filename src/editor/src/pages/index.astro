---
// 编辑器页面骨架。
//
// Astro 在这里只负责出静态 HTML：数据全部来自后端 /api，
// 所以首屏是空壳，交互在 app.ts 里。这么切是因为 3548 条数据
// 一次塞进 HTML 会让首屏很慢，而它几乎总是要立刻整表重排 ——
// 不如先出骨架再取数据。
import '../styles/editor.css';

const title = 'PR2 本地化 · 译文编辑';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
  <header class="toolbar">
    <span class="brand">PR2 本地化工作台</span>
    <nav class="tabs">
      <button class="tab active" data-view="editor" type="button">译文编辑</button>
      <button class="tab" data-view="start" type="button">安装与启动</button>
    </nav>
  </header>

  <section id="view-editor" class="view">
    <div class="editor-bar">
      <span class="editor-tools">
        <label class="tb">编辑
          <select id="lang"></select>
        </label>
        <button id="addLang" class="mini icon-btn" title="添加一种语言"><span class="ic ic-plus" aria-hidden="true"></span></button>
        <input id="q" type="search" placeholder="搜索 id 或原文 / 译文…" spellcheck="false" />
        <label class="tb">字号
          <select id="size">
            <option value="14">14</option>
            <option value="16">16</option>
            <option value="18">18</option>
            <option value="20">20</option>
            <option value="24" selected>24</option>
            <option value="28">28</option>
            <option value="32">32</option>
            <option value="40">40</option>
            <option value="48">48</option>
          </select>
        </label>
        <button id="save" disabled>保存</button>
      </span>

      <span class="nav-group">
        <button id="first" class="mini" hidden>首条</button>
        <button id="prev" class="mini">&lsaquo; 上一条</button>
        <input id="pageInput" class="page-num" type="number" min="1" step="1" aria-label="第几条" />
        <span id="pageCount">共 0 条</span>
        <button id="next" class="mini">下一条 &rsaquo;</button>
        <button id="last" class="mini" hidden>末条</button>
      </span>

      <span class="jump-box">
        <input id="jumpHash" placeholder="0x… 跳转" spellcheck="false" autocomplete="off" />
        <div id="jumpList" class="jump-list" hidden></div>
      </span>
      <button id="jumpGo">跳转</button>

      <span id="stat"></span>
      <span id="dirty" class="dirty"></span>
    </div>

    <div class="workspace">
      <aside id="list" class="side-list" aria-label="条目列表"></aside>
      <main id="rows"></main>
    </div>
  </section>

  <section id="view-start" class="view" hidden>
    <div class="start-col">



    <section class="card">
      <h2>1 游戏目录</h2>
      <div class="row">
        <input id="dir" type="text" spellcheck="false"
               placeholder="游戏安装目录" />
        <button id="browseDir">浏览…</button>
        <button id="pickDir">检测并记住</button>
      </div>
      <p id="dirMsg" class="msg"></p>
      <p id="statusLine" class="msg"></p>
      <ul id="dirList" class="dir-list"></ul>
    </section>

    <section class="card">
      <h2>2 构建与部署</h2>
      <div id="langs" class="langs"></div>
      <div class="row">
        <button id="build">构建注入器 + 语言包</button>
        <button id="deploy">部署到游戏目录</button>
      </div>
      <p class="msg">构建会调用 MSVC 编译 DLL 与启动器；部署只复制文件，不改 PR2.exe。</p>
    </section>

    <section class="card">
      <h2>3 启动</h2>
      <div class="row">
        <label>语言 <select id="launchLang"></select></label>
        <button id="setLang">设为游戏语言</button>
        <button id="play">启动游戏（已注入）</button>
        <button id="vanilla">启动原版对比</button>
        <button id="openEditor">打开译文编辑</button>
      </div>
    </section>

    <section class="card">
      <h2>服务状态</h2>
      <p id="srvInfo" class="msg"></p>
      <div class="row"><button id="srvRefresh">刷新</button></div>
      <ul id="srvList" class="srv-list"></ul>
    </section>
    </div>
    <aside class="card log-card">
      <h2>日志</h2>
      <pre id="log" class="log"></pre>
    </aside>
    
  </section>

    <div id="loading" class="loading" hidden>
      <div class="spinner" aria-hidden="true"></div>
      <span>载入中…</span>
    </div>

    <!-- 语境推断 -->
    <div id="ctxModal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="ctxTitle">
        <h2 id="ctxTitle">语境推断</h2>
        <div id="ctxBody" class="ctx-body"></div>
        <div class="modal-actions">
          <button id="ctxClose">关闭</button>
        </div>
      </div>
    </div>

    <!-- 规则轨迹：这条译文逐阶段经过了哪些格式化规则 -->
    <div id="ruleModal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="ruleTitle">
        <h2 id="ruleTitle">规则轨迹</h2>
        <div id="ruleStages" class="rule-stages"></div>
        <div class="modal-actions"><button id="ruleClose">关闭</button></div>
      </div>
    </div>

    <!-- 初版：默认锁定，逐条解锁，仅本次修改有效 -->
    <div id="seedModal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="seedTitle">
        <h2 id="seedTitle">初版文本</h2>
        <p id="seedLockInfo" class="modal-note">初版默认锁定。解锁后只能改这一条，保存或关闭后重新锁定。</p>
        <textarea id="seedText" class="seed-text" readonly></textarea>
        <div class="modal-actions">
          <button id="seedUnlock">解锁编辑</button>
          <button id="seedSave" disabled>保存初版</button>
          <button id="seedClose">关闭</button>
        </div>
      </div>
    </div>

    <!-- 添加语言：选一个已存在的语言当模板，复制成新语言的基础 -->
    <div id="modal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="newTitle">
        <h2 id="newTitle">添加语言</h2>

        <label>
          语言代码（文件名，也是游戏里 locale.ini 用的值）
          <input id="newCode" placeholder="例如 zh-TW、de、es" spellcheck="false" />
        </label>

        <label>
          以哪种语言为模板
          <select id="newFrom"></select>
        </label>

        <p class="modal-note">
          会复制一份该语言的全部条目作为新语言的基础；之后逐条改就是新译文。
        </p>
        <p id="newErr" class="modal-err"></p>

        <div class="modal-actions">
          <button id="newCancel">取消</button>
          <button id="newOk">创建</button>
        </div>
      </div>
    </div>

    <script src="../scripts/app.ts"></script>
  <script>import '../scripts/start';</script>
  </body>
</html>
