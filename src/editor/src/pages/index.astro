---
// 编辑器页面骨架。
//
// Astro 在这里只负责出静态 HTML：数据全部来自后端 /api，
// 所以首屏是空壳，交互在 app.ts 里。这么切是因为 3548 条数据
// 一次塞进 HTML 会让首屏很慢，而它几乎总是要立刻整表重排 ——
// 不如先出骨架再取数据。
import '../styles/editor.css';

const title = 'PR2 本地化编辑器';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="bar">
      <span class="brand">PR2 本地化编辑器</span>

      <label class="field">
        编辑
        <select id="lang"></select>
      </label>
      <button id="addLang" class="mini" title="添加一种语言">＋</button>

      <span class="sep"></span>

      <label class="field">
        参照
        <select id="refA" class="ref-sel"></select>
      </label>
      <label class="field">
        <select id="refB" class="ref-sel"></select>
      </label>

      <label class="field">
        筛选
        <select id="filter">
          <option value="all">全部</option>
          <option value="unreviewed">未审核</option>
          <option value="reviewed">已审核</option>
          <option value="attention">有问题</option>
        </select>
      </label>

      <span class="sep"></span>

      <button id="theme" class="mini theme-btn" title="切换浅色/深色">🌙</button>

      <label class="field">
        宽度
        <select id="width">
          <option value="600">600</option>
          <option value="720">720</option>
          <option value="900" selected>900</option>
          <option value="1080">1080</option>
        </select>
      </label>

      <label class="field">
        字号
        <select id="size">
          <option value="12">12</option>
          <option value="14">14</option>
          <option value="16" selected>16</option>
          <option value="18">18</option>
          <option value="20">20</option>
        </select>
      </label>
    </header>

    <div class="foot topbar">
      <input id="q" type="search" placeholder="搜索 id 或原文 / 译文…" spellcheck="false" />
      <span id="stat">载入中…</span>
      <span id="dirty" class="dirty"></span>

      <span class="pager">
        <button id="first" class="pg" title="第一页 (Home)">«</button>
        <button id="prev" class="pg" title="上一页 (←)">‹</button>
        <input id="pageInput" class="page-num" type="number" min="1" step="1"
               aria-label="页码" />
        <span id="pageCount">/ 1</span>
        <button id="next" class="pg" title="下一页 (→)">›</button>
        <button id="last" class="pg" title="最后一页 (End)">»</button>
      </span>

      <span class="jump">
        <button id="random" title="随机跳到一条">随机</button>
        <span class="jump-box">
          <input id="jumpHash" placeholder="0x… 跳转" spellcheck="false"
                 autocomplete="off" />
          <div id="jumpList" class="jump-list" hidden></div>
        </span>
        <button id="jumpGo" title="跳到指定 hash">跳转</button>
      </span>

      <span class="hint">Ctrl+Enter 下一条</span>
      <button id="save" disabled>保存</button>
    </div>


    <main id="rows"></main>


    <!-- 语境推断 -->
    <div id="ctxModal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="ctxTitle">
        <h2 id="ctxTitle">语境推断</h2>
        <div id="ctxBody" class="ctx-body"></div>
        <div class="modal-actions">
          <button id="ctxClose">关闭</button>
        </div>
      </div>
    </div>

    <!-- 添加语言：选一个已存在的语言当模板，复制成新语言的基础 -->
    <div id="modal" class="modal" hidden>
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="newTitle">
        <h2 id="newTitle">添加语言</h2>

        <label>
          语言代码（文件名，也是游戏里 locale.ini 用的值）
          <input id="newCode" placeholder="例如 zh-TW、de、es" spellcheck="false" />
        </label>

        <label>
          以哪种语言为模板
          <select id="newFrom"></select>
        </label>

        <p class="modal-note">
          会复制一份该语言的全部条目作为新语言的基础；之后逐条改就是新译文。
        </p>
        <p id="newErr" class="modal-err"></p>

        <div class="modal-actions">
          <button id="newCancel">取消</button>
          <button id="newOk">创建</button>
        </div>
      </div>
    </div>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
