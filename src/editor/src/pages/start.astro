---
import '../styles/editor.css';
const title = 'PR2 本地化 · 安装与启动';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body class="start-body">
  <header class="toolbar">
    <span class="brand">PR2 本地化工作台</span>
    <nav class="tabs">
      <a class="tab" href="/">编辑器</a>
      <a class="tab active" href="/start">安装与启动</a>
    </nav>
    <span id="ver" class="stat-item"></span>
  </header>

  <main class="start-main">
    <section class="card">
      <h2>1 游戏目录</h2>
      <div class="row">
        <input id="dir" type="text" spellcheck="false"
               placeholder="例如 <游戏目录>" />
        <button id="pickDir">检测并记住</button>
      </div>
      <p id="dirMsg" class="msg"></p>
      <p id="statusLine" class="msg"></p>
    </section>

    <section class="card">
      <h2>2 构建与部署</h2>
      <div id="langs" class="langs"></div>
      <div class="row">
        <button id="build">构建注入器 + 语言包</button>
        <button id="deploy">部署到游戏目录</button>
      </div>
      <p class="msg">构建会调用 MSVC 编译 DLL 与启动器；部署只复制文件，不改 PR2.exe。</p>
    </section>

    <section class="card">
      <h2>3 启动</h2>
      <div class="row">
        <label>语言 <select id="launchLang"></select></label>
        <button id="setLang">设为游戏语言</button>
        <button id="play">启动游戏（已注入）</button>
        <button id="vanilla">启动原版对比</button>
        <button id="openEditor">打开编辑器</button>
      </div>
    </section>

    <section class="card">
      <h2>日志</h2>
      <pre id="log" class="log"></pre>
    </section>
  </main>

  <script>
    const S = { status: null, timer: 0 };

    const $ = (id) => document.getElementById(id);

    async function api(path, body) {
      const opt = body === undefined ? {} : {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      };
      const r = await fetch(path, opt);
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.detail || data.error || ('HTTP ' + r.status));
      return data;
    }

    function fillStatus(st) {
      S.status = st;
      $('ver').textContent = st.valid ? (st.version || '') : '未选择目录';
      $('statusLine').textContent = st.valid
        ? `语言包：${(st.packs || []).join('、') || '（无）'} · locale.ini：${st.locale || '（空）'}`
        : '';
      $('dir').value = st.dir || '';

      const box = $('langs');
      box.innerHTML = '';
      for (const code of st.langs || []) {
        const lab = document.createElement('label');
        lab.className = 'lang';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = (st.packs || []).includes(code) || (st.langs || []).length === 1;
        cb.value = code;
        lab.appendChild(cb);
        lab.appendChild(document.createTextNode(code));
        box.appendChild(lab);
      }

      const sel = $('launchLang');
      sel.innerHTML = '';
      for (const code of st.packs || []) {
        const o = document.createElement('option');
        o.value = code;
        o.textContent = code;
        sel.appendChild(o);
      }
      if (st.locale) sel.value = st.locale;
    }

    async function refresh() {
      try {
        fillStatus(await api('/api/start/status'));
      } catch (err) {
        $('dirMsg').textContent = '读取状态失败：' + err.message;
      }
    }

    async function saveDir() {
      $('dirMsg').textContent = '检测中…';
      try {
        const st = await api('/api/start/dir', { path: $('dir').value.trim() });
        fillStatus(st);
        $('dirMsg').textContent = '已记住：' + st.dir;
      } catch (err) {
        $('dirMsg').textContent = err.message;
      }
    }

    function chosenLangs() {
      return Array.from($('langs').querySelectorAll('input:checked')).map((x) => x.value);
    }

    async function pollJob() {
      try {
        const st = await api('/api/start/job');
        $('log').textContent = (st.lines || []).join('\n');
        $('log').scrollTop = $('log').scrollHeight;
        if (st.running) return;
        if (S.timer) { clearInterval(S.timer); S.timer = 0; }
        if (st.done && st.error) $('log').textContent += '\n[错误] ' + st.error;
        await refresh();
      } catch { /* ignore */ }
    }

    function startPolling() {
      if (S.timer) return;
      S.timer = setInterval(pollJob, 400);
      void pollJob();
    }

    async function runJob(kind, body) {
      try {
        const r = await api('/api/start/' + kind, body);
        if (!r.ok) { $('log').textContent = r.error || '启动失败'; return; }
        $('log').textContent = '任务已开始…';
        startPolling();
      } catch (err) {
        $('log').textContent = err.message;
      }
    }

    $('pickDir').addEventListener('click', () => void saveDir());
    $('dir').addEventListener('keydown', (ev) => { if (ev.key === 'Enter') void saveDir(); });
    $('build').addEventListener('click', () => void runJob('build', { langs: chosenLangs() }));
    $('deploy').addEventListener('click', () => void runJob('deploy', { langs: chosenLangs() }));

    $('setLang').addEventListener('click', async () => {
      try {
        const st = await api('/api/start/lang', { lang: $('launchLang').value });
        fillStatus(st);
        $('log').textContent = '游戏语言已设为 ' + st.lang;
      } catch (err) { $('log').textContent = err.message; }
    });

    $('play').addEventListener('click', async () => {
      try {
        const r = await api('/api/start/launch', { lang: $('launchLang').value });
        $('log').textContent = r.message || '';
      } catch (err) { $('log').textContent = err.message; }
    });
    $('vanilla').addEventListener('click', async () => {
      try {
        const r = await api('/api/start/launch', { vanilla: true });
        $('log').textContent = r.message || '';
      } catch (err) { $('log').textContent = err.message; }
    });
    $('openEditor').addEventListener('click', () => { location.href = '/'; });

    void refresh();
  </script>
</body>
</html>

<style>
  .start-body { padding: 0; }
  .start-main {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: calc(100vh - 3.2rem);
    overflow: auto;
  }
  .card {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.9rem 1.1rem 1.1rem;
  }
  .card h2 { margin: 0 0 0.6rem; font-size: 1rem; color: var(--accent); }
  .row { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  #dir { flex: 1 1 22rem; }
  .langs { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.7rem; }
  .lang { display: inline-flex; align-items: center; gap: 0.35rem; }
  .msg { color: var(--fg-dim); font-size: 0.9em; margin: 0.4rem 0 0; }
  .log {
    margin: 0;
    min-height: 12rem;
    max-height: 22rem;
    overflow: auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: pre-wrap;
  }
</style>
